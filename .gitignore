# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Data and outputs are rebuilt from the download scripts. Yahoo's terms
# restrict redistribution, so raw prices are never committed.
/data/*
!/data/.gitkeep
!/data/README.md
/out/*
!/out/.gitkeep
/dist/

# Local secrets (API keys, SEC User-Agent contact); never commit them.
.env

# Agent scratch
.claude/

# LaTeX build files (the PDFs are tracked)
/deliverables/**/*.aux
/deliverables/**/*.bbl
/deliverables/**/*.blg
/deliverables/**/*.fdb_latexmk
/deliverables/**/*.fls
/deliverables/**/*.log
/deliverables/**/*.nav
/deliverables/**/*.out
/deliverables/**/*.snm
/deliverables/**/*.toc
/deliverables/**/*.vrb
